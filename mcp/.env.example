# Required for a public deployment. Leave empty only for a private/internal server.
XILUQT_MCP_TOKEN=replace-with-a-long-random-secret

# Optional hardening
PORT=3000
RATE_LIMIT=60
RATE_WINDOW_MS=60000
ALLOWED_HOSTS=your-mcp-host.example.com
ALLOWED_ORIGINS=https://chatgpt.com,https://www.chatgpt.com

# Optional local LLM bridge
OLLAMA_URL=http://127.0.0.1:11434
